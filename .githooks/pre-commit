#!/bin/sh
# Enforces the privacy rules of docs/decisions/0007-public-repository.md.
# Enabled by: git config core.hooksPath .githooks
set -e

if ! command -v gitleaks >/dev/null 2>&1; then
	echo "pre-commit: gitleaks is not installed." >&2
	echo "  macOS:  brew install gitleaks" >&2
	echo "  Debian: see https://github.com/gitleaks/gitleaks#installing" >&2
	exit 1
fi

staged=$(git diff --cached --name-only --diff-filter=ACMR)

# Files that must never be committed, even with 'git add -f'.
forbidden=$(echo "$staged" | grep -E \
	'(^|/)config\.ya?ml$|(^|/)\.env|\.(db|sqlite3?|pem|key|token)$|(^|/)(data|backups)/' || true)
if [ -n "$forbidden" ]; then
	echo "pre-commit: these files hold configuration, secrets or measurements:" >&2
	echo "$forbidden" | sed 's/^/  /' >&2
	echo "They belong on the server, not in a public repository (ADR 0007)." >&2
	exit 1
fi

gitleaks git --staged --redact --no-banner

# Behaviour lives in docs/specs (ADR 0009). Changing implementation without touching a spec
# is often spec rot — but a spec is not always due, so this warns and never blocks.
guarded=$(echo "$staged" | grep -E '^internal/' || true)
specs=$(echo "$staged" | grep -E '^docs/specs/' | grep -v 'TEMPLATE.md' || true)
if [ -n "$guarded" ] && [ -z "$specs" ]; then
	echo "pre-commit: warning — implementation changed, no spec touched:" >&2
	echo "$guarded" | sed 's/^/  /' >&2
	echo "Check it yourself: update docs/specs if behaviour changed; ignore this if the work" >&2
	echo "is spec-exempt under ADR 0009 (library wrapper, skin, infrastructure chore)." >&2
fi
