<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The agent, as a system daemon. Every path is fixed by docs/specs/deployment.md.
	     launchd has no equivalent of EnvironmentFile, so a shell sources it: set -a exports
	     the values, which is how the token reaches the agent, and exec hands the process
	     over so that launchd supervises the agent rather than the shell. The file holds no
	     secret, so it stays a world-readable daemon plist. -->
	<key>Label</key>
	<string>io.github.pravbeseda.monitor-agent</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>set -a &amp;&amp; . /usr/local/etc/monitor/agent.env &amp;&amp; set +a &amp;&amp; exec /usr/local/bin/monitor-agent --hub "$MONITOR_HUB" --node "$MONITOR_NODE"</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/var/log/monitor-agent.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/monitor-agent.log</string>
</dict>
</plist>
