# Example agent environment file — synthetic values only (ADR 0007).
#
# The real file is /etc/monitor/agent.env on Debian and /usr/local/etc/monitor/agent.env on
# macOS, mode 0600 and owned by root. It is never committed: it holds this node's token, and
# the hub URL and node name say which installation this is.

MONITOR_HUB=https://hub.example.com
MONITOR_NODE=laptop-a
MONITOR_TOKEN=replace-me
